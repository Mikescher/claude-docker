#!/usr/bin/env bash
set -euo pipefail

IMAGE="${CCC_IMAGE:-claude-docker}"

# Chrome is not started up front. A lazy TCP broker (socat, started further
# down) listens on 127.0.0.1:9222 — the address ccc-entrypoint hardcodes into
# the container's chrome-devtools-mcp — and runs *this script* with
# --internal-chrome-relay for every connection it accepts. The relay makes
# sure a host chrome is up, then splices the connection through to it. So
# chrome starts on the first chrome MCP tool call and never before, and the
# container needs to know nothing about any of it.
#
# The two ports are split on purpose: chrome owns 9223 for its whole life, the
# broker owns 9222. Only the first request of an MCP session crosses the
# broker — /json/version answers with a ws:// URL naming 9223, which puppeteer
# then dials directly (host networking, so the container reaches it).
#
# Both processes outlive ccc, so the next session finds a warm browser and a
# live broker instead of paying the cold start again.
chrome_broker_port=9222
chrome_debug_port=9223
chrome_cache="${XDG_CACHE_HOME:-$HOME/.cache}/ccc-chrome"

chrome_bin() {
  local c
  for c in ${CCC_CHROME:+"$CCC_CHROME"} google-chrome-stable google-chrome chromium; do
    if command -v "$c" >/dev/null 2>&1; then
      printf '%s\n' "$c"
      return 0
    fi
  done
  return 1
}

# Is anything listening on port $1? Read procfs rather than connecting, since
# connecting to the broker is exactly what wakes it — and rather than shelling
# out to `ss`, which is a popular name for a personal script and may be
# anything at all on the user's PATH. In /proc/net/tcp{,6} local_address is
# hex IP:port and state 0A is LISTEN; any local address counts, because a
# wildcard listener would collide with our loopback bind just the same.
chrome_port_busy() {
  local hex f addr st procfs=0
  hex=$(printf '%04X' "$1")
  for f in /proc/net/tcp /proc/net/tcp6; do
    [[ -r "$f" ]] || continue
    procfs=1
    while read -r _ addr _ st _; do
      [[ "$st" == 0A && "$addr" == *:"$hex" ]] && return 0
    done < "$f"
  done
  [[ "$procfs" -eq 1 ]] && return 1
  curl -fsS --max-time 1 "http://127.0.0.1:$1/json/version" >/dev/null 2>&1
}

# Bring up a host chrome with a devtools endpoint on $1, returning only once it
# answers. Idempotent, so every relayed connection can call it. Writes nothing
# to stdout — in relay mode stdout is the client socket.
ensure_chrome() {
  local port="$1"
  local profile="$chrome_cache/profile-$port"
  local bin i

  if curl -fsS --max-time 1 "http://127.0.0.1:$port/json/version" >/dev/null 2>&1; then
    return 0
  fi

  if ! bin="$(chrome_bin)"; then
    echo "ccc: no chrome found (tried \$CCC_CHROME, google-chrome-stable, google-chrome, chromium)" >&2
    return 1
  fi

  # A fresh profile greets you with the first-run flow, the metrics-consent
  # screen and — after any unclean exit — the "Restore pages?" bubble, all of
  # them modal enough to stall CDP-driven navigation. The launch flags cover
  # most of it, these two files cover the rest. Written only when the profile
  # does not exist yet, so later choices made in this browser survive.
  if [[ ! -d "$profile" ]]; then
    mkdir -p "$profile/Default"
    printf '%s\n' '{"user_experience_metrics":{"reporting_enabled":false}}' > "$profile/Local State"
    printf '%s\n' '{"browser":{"has_seen_welcome_page":true},"profile":{"exit_type":"Normal","exited_cleanly":true}}' > "$profile/Default/Preferences"
  fi

  # setsid: chrome has to survive both the relay child that spawned it and ccc
  # itself, and a Ctrl-C in ccc's terminal signals the whole foreground process
  # group — which chrome answers by shutting down.
  # --password-store=basic stops a fresh profile from popping a kwallet /
  # gnome-keyring unlock dialog, which is as modal as the rest.
  setsid -f "$bin" \
    --remote-debugging-port="$port" \
    --user-data-dir="$profile" \
    --no-first-run \
    --no-default-browser-check \
    --disable-search-engine-choice-screen \
    --hide-crash-restore-bubble \
    --password-store=basic \
    --noerrdialogs \
    about:blank </dev/null >/dev/null 2>&1

  # `setsid -f` returns before the exec, so polling is the only honest
  # readiness check. A warm chrome needs ~1s, a cold profile a little more.
  for ((i = 0; i < 30; i++)); do
    sleep 0.5
    if curl -fsS --max-time 1 "http://127.0.0.1:$port/json/version" >/dev/null 2>&1; then
      return 0
    fi
  done
  echo "ccc: chrome did not open a devtools port on $port within 15s" >&2
  return 1
}

# Hidden entry point: one invocation per connection the broker accepts, with
# stdin/stdout wired to that connection. Nothing below this point — flag
# parsing, the image check, the version prompt — may run here.
if [[ "${1:-}" == "--internal-chrome-relay" ]]; then
  ensure_chrome "$chrome_debug_port" || exit 1
  exec socat - "TCP:127.0.0.1:$chrome_debug_port"
fi

usage() {
  cat <<'EOF'
ccc - run Claude Code in a Docker container

Usage: ccc [ccc-flags] [claude-args ...]

ccc flags (consumed by the wrapper, not forwarded):
  --mount DIR          additionally bind-mount DIR into the container at the
                       same absolute path (errors if DIR does not exist). May
                       be given multiple times.
  --mount-ro DIR       like --mount, but mount DIR read-only. May be given
                       multiple times.
  --mount-parent       mount the parent directory (so siblings are reachable)
                       instead of just the current directory. The mount target
                       inside the container always matches the host path. This
                       is also enabled automatically when the workdir is a git
                       worktree whose gitdir lives under the parent.
  --net                use a private bridge network instead of the host's
                       (the default is --network host so host services on
                       127.0.0.1 — e.g. mongodb on 27017 — are reachable as
                       localhost from inside the container)
  --no-version-check   skip the upstream version comparison
  --no-docker          do not forward the host's docker socket
  --no-cache           do not mount the language cache directories
                       (~/go/pkg, ~/.cache/go-build, ~/.npm, ~/.nvm, ~/.cache/pip,
                       ~/.cache/uv, ~/.cargo, ~/.nuget, ~/.gradle, ~/.pub-cache)
  --no-cpu-limit       do not constrain the container's CPU count
                       (default: host CPUs minus 2)
  --no-memory-limit    do not constrain the container's memory
                       (default: host RAM minus 8 GiB)
  --no-limit           shorthand for --no-cpu-limit --no-memory-limit
  --shell              drop into bash inside the container instead of running claude
  --chrome             start the host chrome right away instead of on first use,
                       so the first chrome MCP tool call pays no cold start
  --no-chrome          do not front 127.0.0.1:9222 with the lazy chrome broker
                       (chrome-devtools-mcp tools then have nothing to attach to)
  -h, --help           show this help and exit

Anything else is forwarded to `claude` (which always runs with
--dangerously-skip-permissions). Use `--` to terminate ccc-flag parsing
explicitly: `ccc --mount-parent -- --print "query"`.

Environment:
  CCC_IMAGE    override the docker image name (default: claude-docker)
  CCC_CHROME   chrome binary to launch (default: the first of
               google-chrome-stable, google-chrome, chromium on PATH)

Chrome on demand:
  ccc puts a lazy broker (socat) on 127.0.0.1:9222, the address the
  container's chrome-devtools-mcp attaches to. The first connection starts
  chrome on the host with --remote-debugging-port=9223 and a persistent
  profile under ~/.cache/ccc-chrome, then relays the connection through — so
  the chrome MCP is always usable and chrome only opens when it is actually
  used. Both chrome and the broker are left running when ccc exits. Needs
  socat on the host and --network host (the default).
EOF
}

mount_parent=0
host_net=1
skip_version_check=0
do_shell=0
mount_docker=1
mount_cache=1
chrome_enabled=1
chrome_eager=0
limit_cpu=1
limit_memory=1
extra_mounts=()
extra_mounts_ro=()
forwarded_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mount)
      if [[ $# -lt 2 ]]; then
        echo "ccc: --mount requires a directory argument" >&2
        exit 1
      fi
      if [[ ! -d "$2" ]]; then
        echo "ccc: --mount: directory '$2' does not exist" >&2
        exit 1
      fi
      extra_mounts+=( "$(cd -- "$2" &>/dev/null && pwd)" )
      shift 2
      ;;
    --mount-ro)
      if [[ $# -lt 2 ]]; then
        echo "ccc: --mount-ro requires a directory argument" >&2
        exit 1
      fi
      if [[ ! -d "$2" ]]; then
        echo "ccc: --mount-ro: directory '$2' does not exist" >&2
        exit 1
      fi
      extra_mounts_ro+=( "$(cd -- "$2" &>/dev/null && pwd)" )
      shift 2
      ;;
    --mount-parent)     mount_parent=1; shift ;;
    --net)              host_net=0; shift ;;
    --no-version-check) skip_version_check=1; shift ;;
    --no-docker)        mount_docker=0; shift ;;
    --no-cache)         mount_cache=0; shift ;;
    --no-cpu-limit)     limit_cpu=0; shift ;;
    --no-memory-limit)  limit_memory=0; shift ;;
    --no-limit)         limit_cpu=0; limit_memory=0; shift ;;
    --shell)            do_shell=1; shift ;;
    --chrome)           chrome_eager=1; shift ;;
    --no-chrome)        chrome_enabled=0; shift ;;
    -h|--help)          usage; exit 0 ;;
    --)                 shift; forwarded_args+=("$@"); break ;;
    *)                  forwarded_args+=("$1"); shift ;;
  esac
done

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$self")" &>/dev/null && pwd)"

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "ccc: image '$IMAGE' not found — run 'make build' in $script_dir first" >&2
  exit 1
fi

if [[ "$skip_version_check" -eq 0 && "$do_shell" -eq 0 && -t 0 && -t 1 ]]; then
  latest=$(curl -fsSL --max-time 1 "https://downloads.claude.ai/claude-code-releases/latest" 2>/dev/null || true)
  installed=$(docker image inspect --format '{{ index .Config.Labels "claude_version" }}' "$IMAGE" 2>/dev/null || true)
  if [[ -n "$latest" && -n "$installed" && "$latest" != "$installed" ]]; then
    printf "Claude Code %s is available (image has %s). Continue? [Y/n] " "$latest" "$installed" >&2
    read -r answer </dev/tty || answer=""
    case "${answer,,}" in
      n|no)
        echo "aborted" >&2
        exit 1
        ;;
    esac
  fi
fi

# Install the broker (see the top of this file). Every guard below degrades to
# a single line and a working session — the chrome MCP is the only thing that
# stops working. `eager_port` doubles as the fallback answer for --chrome: it
# is the port to start chrome on now, or empty when there is nothing to do.
if [[ "$chrome_enabled" -eq 1 ]]; then
  eager_port="$chrome_debug_port"
  if chrome_port_busy "$chrome_broker_port"; then
    # A chrome of the user's own, or a broker from a sibling session, already
    # serves the address the container talks to. Leave it alone and use it.
    eager_port=""
  elif ! chrome_bin >/dev/null; then
    echo "ccc: no chrome found — chrome-on-demand disabled (set \$CCC_CHROME or install google-chrome)" >&2
    eager_port=""
  elif [[ "$host_net" -eq 0 ]]; then
    echo "ccc: --net given — chrome-on-demand needs host loopback, skipping" >&2
    eager_port=""
  elif ! command -v socat >/dev/null 2>&1; then
    # No listener without socat, so no on-demand start. --chrome still works,
    # by putting chrome straight onto the port the container attaches to.
    echo "ccc: socat not found — chrome-on-demand disabled (pacman -S socat); --chrome still works" >&2
    eager_port="$chrome_broker_port"
  elif [[ "$self" == *[[:space:],]* || "$self" == *'!!'* ]]; then
    # socat splits an EXEC command line on single spaces and reads ',' as an
    # option separator and '!!' as an address separator, so such a path cannot
    # be handed to it safely.
    echo "ccc: script path '$self' contains a space, comma or '!!' — chrome-on-demand disabled" >&2
    eager_port=""
  else
    # `fork` is what makes this a listener rather than a one-shot: each
    # connection gets its own relay child, with the socket on its stdin and
    # stdout through a socketpair, so HTTP and the binary WebSocket frames that
    # follow pass byte-for-byte. socat's stderr (and every relay child's) goes
    # to the log — truncated per broker, since this is its only owner — because
    # a stray diagnostic behind claude's TUI would corrupt the display. setsid
    # keeps the broker out of ccc's process group, so neither Ctrl-C nor a
    # closing terminal takes it down while a sibling session may still need it.
    mkdir -p "$chrome_cache"
    setsid -f socat "TCP-LISTEN:$chrome_broker_port,bind=127.0.0.1,reuseaddr,fork" \
      "EXEC:$self --internal-chrome-relay" </dev/null >/dev/null 2>"$chrome_cache/broker.log"
  fi
  if [[ "$chrome_eager" -eq 1 && -n "$eager_port" ]]; then
    ensure_chrome "$eager_port" || true
  fi
fi

host_pwd="$PWD"
parent_dir="$(dirname -- "$host_pwd")"

# Auto-detect git worktrees: when the workdir's `.git` is a *file* (not a dir)
# it points at a gitdir elsewhere, e.g.
#   gitdir: /home/me/Code/foo/master/.git/worktrees/wt-4
# git inside the container needs that gitdir, but it lives outside the workdir,
# so a plain workdir mount leaves git broken. In the common `repo/<worktree>`
# layout the gitdir sits under our parent directory, so mounting the parent
# brings it along — switch to a parent mount automatically. Only do this when
# the gitdir really resolves to something under the parent; if it lives
# elsewhere a parent mount wouldn't reach it, so there's nothing to gain.
if [[ "$mount_parent" -eq 0 && -f "$host_pwd/.git" ]]; then
  read -r gitdir_marker gitdir_target < "$host_pwd/.git" || true
  if [[ "${gitdir_marker:-}" == "gitdir:" && -n "${gitdir_target:-}" ]]; then
    [[ "$gitdir_target" != /* ]] && gitdir_target="$host_pwd/$gitdir_target"
    gitdir_canon="$(readlink -f -- "$gitdir_target" 2>/dev/null || true)"
    parent_canon="$(readlink -f -- "$parent_dir" 2>/dev/null || true)"
    if [[ -n "$gitdir_canon" && -d "$gitdir_canon" \
          && -n "$parent_canon" && "$gitdir_canon" == "$parent_canon"/* ]]; then
      mount_parent=1
      echo "ccc: git worktree detected — mounting $parent_dir so its gitdir is reachable" >&2
    fi
  fi
fi

if [[ "$mount_parent" -eq 1 ]]; then
  mount_src="$parent_dir"
else
  mount_src="$host_pwd"
fi
workdir_in="$host_pwd"

container_user=$(docker image inspect --format '{{ .Config.User }}' "$IMAGE" 2>/dev/null || true)
container_home="/home/${container_user:-dev}"

base_name="ccc-$(basename -- "$host_pwd")"
base_name="${base_name//[^a-zA-Z0-9_.-]/_}"
container_name="$base_name"
n=1
while docker container inspect "$container_name" >/dev/null 2>&1; do
  container_name="${base_name}_${n}"
  n=$((n + 1))
done

mkdir -p "$HOME/.claude"

docker_args=(
  --rm
  --name "$container_name"
  -v "$mount_src:$mount_src"
  -w "$workdir_in"
  -e "TERM=${TERM:-xterm-256color}"
)

for m in ${extra_mounts[@]+"${extra_mounts[@]}"}; do
  docker_args+=( -v "$m:$m" )
done

for m in ${extra_mounts_ro[@]+"${extra_mounts_ro[@]}"}; do
  docker_args+=( -v "$m:$m:ro" )
done

docker_args+=( -v "$HOME/.claude:$container_home/.claude" )

[[ -f "$HOME/.claude.json" ]] && docker_args+=( -v "$HOME/.claude.json:$container_home/.claude.json" )

if [[ "$mount_cache" -eq 1 ]]; then
  [[ -d "$HOME/go/pkg" ]]          && docker_args+=( -v "$HOME/go/pkg:$container_home/go/pkg" )
  [[ -d "$HOME/.cache/go-build" ]] && docker_args+=( -v "$HOME/.cache/go-build:$container_home/.cache/go-build" )
  [[ -d "$HOME/.npm" ]]            && docker_args+=( -v "$HOME/.npm:$container_home/.npm" )
  # nvm: persist downloaded tarballs (.cache) and installed node versions
  # (versions) so the `.nvmrc` `nvm install` at container start is near-instant
  # on repeat runs. Unlike the other caches these are mkdir'd rather than
  # gated on pre-existence, because the dirs must exist for the install to be
  # captured and reused next time.
  mkdir -p "$HOME/.nvm/.cache" "$HOME/.nvm/versions"
  docker_args+=( -v "$HOME/.nvm/.cache:$container_home/.nvm/.cache" )
  docker_args+=( -v "$HOME/.nvm/versions:$container_home/.nvm/versions" )
  [[ -d "$HOME/.cache/pip" ]]      && docker_args+=( -v "$HOME/.cache/pip:$container_home/.cache/pip" )
  [[ -d "$HOME/.ant" ]]            && docker_args+=( -v "$HOME/.ant:$container_home/.ant" )
  [[ -d "$HOME/.ivy2" ]]           && docker_args+=( -v "$HOME/.ivy2:$container_home/.ivy2" )
  [[ -d "/usr/share/ant/lib" ]]    && docker_args+=( -v "/usr/share/ant/lib:/usr/share/ant/lib" )
  [[ -d "$HOME/.gradle" ]]         && docker_args+=( -v "$HOME/.gradle:$container_home/.gradle" )
  [[ -d "$HOME/.pub-cache" ]]      && docker_args+=( -v "$HOME/.pub-cache:$container_home/.pub-cache" )
fi

if [[ "$host_net" -eq 1 ]]; then
  docker_args+=( --network host )
else
  docker_args+=( --add-host=host.docker.internal:host-gateway )
fi

# Chrome's install tree, read-only, for anything in the container that wants to
# exec the browser itself (flutter's web target, playwright's CHROME_EXECUTABLE).
# Unrelated to the broker — the chrome MCP only ever speaks CDP over the network.
[[ -d "/opt/google/chrome" ]] && docker_args+=( -v "/opt/google/chrome:/opt/google/chrome:ro" )


# Resource limits: leave headroom on the host so a runaway build inside the
# container can't starve the desktop. Defaults are (host CPUs - 2) and
# (host RAM - 8 GiB); both opt-out via --no-cpu-limit / --no-memory-limit
# / --no-limit. Skipped silently when the host is too small for the headroom
# to leave a positive budget.
if [[ "$limit_cpu" -eq 1 ]]; then
  host_cpus=$(nproc 2>/dev/null || echo 0)
  cpu_budget=$(( host_cpus - 2 ))
  if [[ "$cpu_budget" -gt 0 ]]; then
    docker_args+=( --cpus="$cpu_budget" )
  fi
fi
if [[ "$limit_memory" -eq 1 ]]; then
  mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
  mem_gib=$(( mem_kb / 1024 / 1024 ))
  mem_budget=$(( mem_gib - 8 ))
  if [[ "$mem_budget" -gt 0 ]]; then
    docker_args+=( --memory="${mem_budget}g" )
  fi
fi

# Forward the host's docker socket so claude can build/run docker images.
# This is sibling-container DinD: commands talk to the host daemon, so any
# bind-mount paths used inside the container are interpreted on the host.
# The user needs the socket's GID as a supplementary group to access it
# without sudo; that GID varies per host (commonly 999 or 998), so it's
# resolved at runtime via --group-add rather than baked into the image.
if [[ "$mount_docker" -eq 1 && -S /var/run/docker.sock ]]; then
  docker_args+=( -v /var/run/docker.sock:/var/run/docker.sock )
  docker_sock_gid=$(stat -c '%g' /var/run/docker.sock)
  docker_args+=( --group-add "$docker_sock_gid" )
fi

# A container-specific git identity/config can be dropped at ~/.gitconfig-ccc on
# the host; it takes precedence and is still mounted as ~/.gitconfig inside, so
# git in the container sees it without any extra config.
if [[ -f "$HOME/.gitconfig-ccc" ]]; then
  docker_args+=( -v "$HOME/.gitconfig-ccc:$container_home/.gitconfig:ro" )
elif [[ -f "$HOME/.gitconfig" ]]; then
  docker_args+=( -v "$HOME/.gitconfig:$container_home/.gitconfig:ro" )
fi

[[ -f /etc/vimrc ]]           && docker_args+=( -v "/etc/vimrc:/etc/vimrc:ro" )
[[ -f /etc/vim/vimrc ]]       && docker_args+=( -v "/etc/vim/vimrc:/etc/vim/vimrc:ro" )
[[ -f "$HOME/.vimrc" ]]       && docker_args+=( -v "$HOME/.vimrc:$container_home/.vimrc:ro" )
[[ -d "$HOME/.vim" ]]         && docker_args+=( -v "$HOME/.vim:$container_home/.vim:ro" )

[[ -d "$HOME/.jdks" ]]         && docker_args+=( -v "$HOME/.jdks:$container_home/.jdks:ro" )

# Wayland clipboard forwarding: claude code's image-paste path shells out to
# `wl-paste --type image/png` (et al.). Bind-mount just the single wayland
# socket — not the rest of $XDG_RUNTIME_DIR — so wl-paste reaches the host
# compositor without also exposing dbus, pulse, gvfs, etc. Container UID
# matches host UID via build-arg, so socket ownership lines up. libwayland
# warns that $XDG_RUNTIME_DIR isn't 0700 (Docker auto-creates the parent as
# root:root 0755) but still connects.
if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
  wayland_sock="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
  if [[ -S "$wayland_sock" ]]; then
    docker_args+=(
      -v "$wayland_sock:$wayland_sock"
      -e "WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
      -e "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
    )
  fi
fi

if [[ "$mount_cache" -eq 1 ]]; then
  [[ -d "$HOME/.cache/uv" ]]  && docker_args+=( -v "$HOME/.cache/uv:$container_home/.cache/uv" )
  [[ -d "$HOME/.cargo" ]]     && docker_args+=( -v "$HOME/.cargo:$container_home/.cargo" )
  [[ -d "$HOME/.nuget" ]]     && docker_args+=( -v "$HOME/.nuget:$container_home/.nuget" )
fi

# notify-send forwarding: container's /usr/local/bin/notify-send (a shim baked
# into the image) writes NUL-separated args to a FIFO. Here we create the FIFO
# on the host, bind-mount it in, and run a tiny background bash reader that
# pipes each notification into the host's real notify-send. Only this single
# named pipe crosses the container boundary — no dbus socket is exposed.
notify_pid=""
notify_dir=""
cleanup_notify() {
  [[ -n "$notify_pid" ]] && kill "$notify_pid" 2>/dev/null || true
  [[ -n "$notify_dir" ]] && rm -rf "$notify_dir"
}
if command -v notify-send >/dev/null 2>&1; then
  notify_dir="$(mktemp -d --tmpdir ccc-notify-XXXXXX)"
  notify_fifo="$notify_dir/fifo"
  mkfifo -m 600 "$notify_fifo"
  (
    while :; do
      args=()
      mapfile -d '' args < "$notify_fifo" || break
      [[ ${#args[@]} -eq 0 ]] && continue
      notify-send "${args[@]}" >/dev/null 2>&1 || true
    done
  ) &
  notify_pid=$!
  trap cleanup_notify EXIT
  docker_args+=( -v "$notify_fifo:/run/ccc-notify.fifo" )
fi

if [[ -t 0 && -t 1 ]]; then
  docker_args+=( -it )
else
  docker_args+=( -i )
fi

# Non-exec so the EXIT trap runs after docker exits (notify forwarder cleanup).
rc=0
if [[ "$do_shell" -eq 1 ]]; then
  docker run "${docker_args[@]}" "$IMAGE" bash -l || rc=$?
else
  docker run "${docker_args[@]}" "$IMAGE" \
    claude --dangerously-skip-permissions ${forwarded_args[@]+"${forwarded_args[@]}"} || rc=$?
fi
exit $rc
